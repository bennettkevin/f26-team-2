<#import "/shared/layout.ftlh" as l>
  <@l.page title="Add Tour" active="add-tour">
    <h1>LocalGuide</h1>
    <div class="card background-grey m-3 p-2">
      <p>Welcome to LocalGuide! This is a platform that connects travelers with local guides for unique experiences. No
        matter the adventure you are searching for we hope you can find it here.
        As a customer you can browse locations and guide services from around the world. As a guide you create a profile
        and list your services to
        connect with travelers. We hope you enjoy your time here and find the adventure you are looking for!</p>
      </p>
    </div>
  </@l.page>