<#assign pageTitle="Login - Local Guide">
  <#include "/shared/layout.ftlh">
    <body>
    <div class="container text-center">
  <div class="row">
    <div class="col">
        <a class="btn btn-primary m-3" href="/customers/customer-login" role="button">Customer login</a>
    </div>
   <!-- <div class="col">
    <a class="btn btn-secondary m-3" href="/providers/login">Guide login</a>
    </div> -->
  </div>
  <h1>LocalGuide</h1>
  <div class="card background-grey m-3 p-2">
    <p>Welcome to LocalGuide! This is a platform that connects travelers with local guides for unique experiences. No matter the adventure you are searching for we hope you can find it here.
      As a customer you can browse locations and guide services from around the world. As a guide you create a profile and list your services to 
      connect with travelers. We hope you enjoy your time here and find the adventure you are looking for!</p>
    </p>
  </div>
</div>

</body>